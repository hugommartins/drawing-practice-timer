{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": { "command": "npx tsx --test tests/unit/*.test.ts" },
  "coverageAnalysis": "off",
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "mutate": [
    "src/shared/**/*.ts",
    "src/main/handlers.ts",
    "src/main/library.ts",
    "src/main/storage.ts",
    "src/main/window.ts"
  ],
  "reporters": ["clear-text", "progress", "html"],
  "htmlReporter": { "fileName": "reports/mutation/logic.html" },
  "thresholds": { "high": 90, "low": 75, "break": 75 },
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental-logic.json",
  "concurrency": 4,
  "timeoutMS": 10000,
  "ignorePatterns": ["dist", "release", "reports", "test-results", "playwright-report"]
}
