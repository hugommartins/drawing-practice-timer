{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": { "command": "node build.mjs && npx playwright test --project=ui --workers=2 --reporter=dot" },
  "coverageAnalysis": "off",
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "mutate": ["src/renderer/**/*.{ts,tsx}", "!src/renderer/**/*.d.ts"],
  "reporters": ["clear-text", "progress", "html"],
  "htmlReporter": { "fileName": "reports/mutation/ui.html" },
  "thresholds": { "high": 80, "low": 60, "break": 60 },
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental-ui.json",
  "concurrency": 2,
  "timeoutMS": 120000,
  "ignorePatterns": ["dist", "release", "reports", "test-results", "playwright-report"]
}
